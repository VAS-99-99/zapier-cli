{
  "api_name": "zapier",
  "base_url": "https://zapier.com",
  "description": "Read-only CLI for your Zapier account: list zaps, check run history, diagnose failures.",
  "mcp_ready": "full",
  "http_transport": "standard",
  "auth": {
    "type": "api_key",
    "header": "Cookie",
    "format": "{ZAPIER_SESSION_COOKIE}",
    "env_vars": [
      "ZAPIER_SESSION_COOKIE"
    ],
    "env_var_specs": [
      {
        "name": "ZAPIER_SESSION_COOKIE",
        "kind": "per_call",
        "required": true,
        "sensitive": true,
        "inferred": true
      }
    ]
  },
  "required_headers": [],
  "tools": [
    {
      "name": "session_check",
      "description": "Check whether the saved session cookie is still valid.",
      "method": "GET",
      "path": "/api/v4/session",
      "params": []
    }
  ]
}
